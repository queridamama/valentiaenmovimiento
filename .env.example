# Supabase — claves nuevas (Settings → API Keys → pestaña "API Keys", no "Legacy")
# Los proyectos creados después de nov. 2025 ya no tienen anon/service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET KEY: bypassea RLS. La usa el servidor únicamente para firmar URLs
# temporales de archivos privados (audios/PDFs en Storage) — nunca llega
# al navegador. Ver lib/supabase/servicio.ts.
SUPABASE_SECRET_KEY=

# Mercado Pago Suscripciones (preapproval/preapproval_plan). Nunca cargar
# valores reales acá ni en un commit — solo en Vercel (Settings →
# Environment Variables) y en .env.local (gitignored). Ver
# supabase/migrations/0012_suscripciones_mercadopago.sql y
# scripts/mercadopago/crear-plan.ts para el procedimiento completo.
# ACCESS TOKEN de la cuenta de Mercado Pago (server-only, nunca al cliente).
MERCADOPAGO_ACCESS_TOKEN=
# id del preapproval_plan de "Valentía Premium" ($35.000 ARS/mes), creado
# UNA sola vez con scripts/mercadopago/crear-plan.ts.
MERCADOPAGO_PREAPPROVAL_PLAN_ID=
# Token propio (inventado por nosotros, ej. `openssl rand -hex 32`). No
# hace falta registrarlo a mano en ningún panel de Mercado Pago: el
# propio código arma la URL .../api/webhooks/mercadopago?token=ESTE_VALOR
# y se la manda a Mercado Pago como `notification_url` al crear cada
# suscripción (crearPreapproval, en lib/mercadopago.ts) — la app de
# Mercado Pago de Valentía es de tipo "Suscripciones", y para ese tipo
# de app "Tus integraciones → Webhooks" no está disponible, así que no
# hay una "Firma secreta" de Mercado Pago que configurar. Este token sí
# depende solo de nosotros, así que SE EXIGE en producción (si falta, no
# se pueden crear suscripciones nuevas — ver lib/mercadopago.ts y
# app/api/webhooks/mercadopago/route.ts).
MERCADOPAGO_WEBHOOK_TOKEN=
# Opcional/best-effort: si Mercado Pago igual llega a mandar el header
# x-signature para esta integración (no hay garantía para apps de tipo
# Suscripciones), se valida con este secreto. Nunca es la única defensa
# ni bloquea el webhook si no está configurada.
MERCADOPAGO_WEBHOOK_SECRET=
# Solo si el flujo de checkout elegido llega a necesitar el SDK de
# Mercado Pago del lado del cliente (hoy no hace falta: se usa el
# init_point del preapproval). Es pública a propósito (Public Key, no
# Access Token) — dejar vacía si no se termina usando.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# URL pública de la app (para webhooks y links de vuelta)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL pública y canónica de la app, para los links que arma Supabase Auth
# (mail de confirmación de registro, recuperación de contraseña — ver
# lib/url.ts). En Vercel: el dominio productivo real de Valentía, sin "/"
# final (ej. https://app.valentiaenmovimiento.com o, mientras no haya
# dominio propio, la URL de Vercel del deploy de producción). Cambiar acá
# el dominio el día de mañana no requiere tocar código.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo para correr supabase/tests/rls.test.ts (nunca en el cliente/browser)
SUPABASE_TEST_ADMIN_EMAIL=
SUPABASE_TEST_ADMIN_PASSWORD=
