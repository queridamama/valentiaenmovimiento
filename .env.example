# Supabase — claves nuevas (Settings → API Keys → pestaña "API Keys", no "Legacy")
# Los proyectos creados después de nov. 2025 ya no tienen anon/service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET KEY: bypassea RLS. La usa el servidor únicamente para firmar URLs
# temporales de archivos privados (audios/PDFs en Storage) — nunca llega
# al navegador. Ver lib/supabase/servicio.ts.
SUPABASE_SECRET_KEY=

# Mercado Pago Suscripciones (preapproval/preapproval_plan). Nunca cargar
# valores reales acá ni en un commit — solo en Vercel (Settings →
# Environment Variables) y en .env.local (gitignored). Ver
# supabase/migrations/0012_suscripciones_mercadopago.sql y
# scripts/mercadopago/crear-plan.ts para el procedimiento completo.
# ACCESS TOKEN de la cuenta de Mercado Pago (server-only, nunca al cliente).
MERCADOPAGO_ACCESS_TOKEN=
# id del preapproval_plan de "Valentía Premium" ($35.000 ARS/mes), creado
# UNA sola vez con scripts/mercadopago/crear-plan.ts.
MERCADOPAGO_PREAPPROVAL_PLAN_ID=
# Public Key de la cuenta de Mercado Pago — SÍ va al cliente a propósito
# (es pública, no el Access Token): la usa @mercadopago/sdk-js en
# components/BotonSuscribirse.tsx para montar el Card Form que genera el
# `card_token_id` (número/CVV viajan dentro de iframes de Mercado Pago,
# nunca tocan nuestro JS ni nuestro backend). Sin esta variable no se
# puede crear ninguna suscripción nueva.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
#
# OPCIONAL — solo para probar en paralelo el otro flujo oficial de
# Mercado Pago ("Suscripciones sin plan asociado" + pago pendiente +
# checkout alojado, init_point) al lado del flujo actual de producción
# (Card Form). En "true" muestra un botón adicional "beta" en
# /membresia — ver components/BotonSuscribirseAlojado.tsx e
# iniciarSuscripcionAlojada en lib/acciones/membresia.ts. Revertir la
# prueba: sacar esta variable (o dejarla en cualquier valor distinto de
# "true"), no requiere ningún otro cambio.
NEXT_PUBLIC_MERCADOPAGO_CHECKOUT_ALOJADO_BETA=
#
# --- Las dos variables de abajo son OPCIONALES ---
# La activación/mantenimiento/cancelación de Premium NO dependen de
# ningún webhook: se hacen por polling server-side directo contra
# GET /preapproval/{id} (ver lib/suscripciones.ts). El motivo: la app de
# Mercado Pago de Valentía es de tipo "Suscripciones", y para ese tipo de
# app "Tus integraciones → Webhooks" no está disponible; y el campo
# `notification_url` que permitiría registrar la URL al crear la
# suscripción no está confirmado en la referencia oficial del endpoint
# (no lo mandamos — ver el comentario largo en lib/mercadopago.ts).
# El endpoint /api/webhooks/mercadopago sigue existiendo como mejora
# opcional a futuro, no como dependencia.
#
# Token propio (ej. `openssl rand -hex 32`) que valida las notificaciones
# que le lleguen a ese endpoint opcional, si alguna vez se termina
# registrando la URL a mano en algún lugar del panel de Mercado Pago.
MERCADOPAGO_WEBHOOK_TOKEN=
# Si Mercado Pago igual llega a mandar el header x-signature, se valida
# con este secreto. Nunca es la única defensa ni bloquea nada si falta.
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública de la app (para webhooks y links de vuelta)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL pública y canónica de la app, para los links que arma Supabase Auth
# (mail de confirmación de registro, recuperación de contraseña — ver
# lib/url.ts). En Vercel: el dominio productivo real de Valentía, sin "/"
# final (ej. https://app.valentiaenmovimiento.com o, mientras no haya
# dominio propio, la URL de Vercel del deploy de producción). Cambiar acá
# el dominio el día de mañana no requiere tocar código.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo para correr supabase/tests/rls.test.ts (nunca en el cliente/browser)
SUPABASE_TEST_ADMIN_EMAIL=
SUPABASE_TEST_ADMIN_PASSWORD=
