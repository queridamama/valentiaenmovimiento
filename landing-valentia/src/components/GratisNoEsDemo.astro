---
import { gratisNoEsDemo } from "../content/valentia";
import { REGISTER_URL } from "../config/site";
---

<section id="gratis" class="px-5 py-20 sm:px-8 sm:py-28">
  <div class="reveal mx-auto grid max-w-5xl gap-10 rounded-[28px] border border-acento-lima/40 bg-acento-lima/10 p-8 sm:p-12 lg:grid-cols-2 lg:gap-16 lg:p-16">
    <div class="space-y-5">
      <h2 class="balance font-display text-[26px] font-semibold leading-tight text-marca sm:text-[34px]">
        {gratisNoEsDemo.titulo}
      </h2>
      <p class="text-[17px] font-medium italic text-marca">{gratisNoEsDemo.frase}</p>
      <a
        href={REGISTER_URL}
        data-analytics="click-empezar-gratis-seccion"
        class="inline-block rounded-full bg-marca px-7 py-3.5 text-[15px] font-semibold text-fondo transition hover:bg-acento hover:text-marca"
      >
        {gratisNoEsDemo.cta}
      </a>
    </div>

    <div class="space-y-3">
      <ul class="space-y-2.5">
        {gratisNoEsDemo.bullets.map((b) => (
          <li class="flex items-start gap-2.5 text-[15px] text-texto/75">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-marca" />
            {b}
          </li>
        ))}
      </ul>
      <p class="pt-2 text-[15px] font-medium text-texto">{gratisNoEsDemo.cierre}</p>
    </div>
  </div>
</section>
