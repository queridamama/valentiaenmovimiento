---
import { semana } from "../content/valentia";
---

<section class="bg-acento-celeste/25 px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-4xl">
    <h2 class="reveal balance mx-auto max-w-lg text-center font-display text-[28px] font-semibold leading-tight text-marca sm:text-[38px]">
      {semana.titulo}
    </h2>

    <p class="reveal mx-auto mt-4 max-w-lg text-center text-[16px] leading-relaxed text-texto/70">{semana.intro}</p>

    <div class="mt-12 grid gap-4 sm:mt-14 sm:grid-cols-3">
      {semana.momentos.map((momento) => (
        <div class="reveal space-y-2 rounded-[20px] bg-tarjeta p-6 text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-marca">{momento.dia}</p>
          <p class="text-[17px] font-medium text-texto">{momento.texto}</p>
        </div>
      ))}
    </div>

    <p class="reveal mx-auto mt-10 max-w-lg text-center text-[15px] text-texto/60">{semana.comunidad}</p>

    <p class="reveal balance mx-auto mt-8 max-w-xl text-center font-display text-xl font-semibold leading-snug text-marca sm:text-2xl">
      {semana.frase}
    </p>
  </div>
</section>
