---
import { semana } from "../content/valentia";
---

<section class="bg-acento-celeste/25 px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-4xl">
    <h2 class="reveal balance mx-auto max-w-lg text-center font-display text-[28px] font-semibold leading-tight text-texto sm:text-[38px]">
      {semana.titulo}
    </h2>

    <div class="mt-12 grid gap-4 sm:mt-14 sm:grid-cols-3">
      {semana.momentos.map((momento) => (
        <div class="reveal space-y-2 rounded-[20px] bg-tarjeta p-6 text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-acento-teal">{momento.dia}</p>
          <p class="text-[17px] font-medium text-texto">{momento.texto}</p>
        </div>
      ))}
    </div>

    <p class="reveal mt-12 text-center font-display text-xl font-semibold text-texto sm:text-2xl">
      {semana.frase}
    </p>
  </div>
</section>
