---
import { meli } from "../content/valentia";
import { withBase } from "../config/site";
import FotoMarca from "./FotoMarca.astro";
---

<section id="meli" class="bg-acento-rosa/30 px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto grid max-w-5xl gap-14 lg:grid-cols-[minmax(0,320px)_1fr] lg:items-center lg:gap-16">
    <div class="reveal mx-auto w-full max-w-[260px] lg:mx-0 lg:max-w-[300px]">
      <FotoMarca
        src={withBase("images/meli.webp")}
        alt="Melisa Díaz"
        srcSecundaria={withBase("images/valentia/meli-detalle.jpg")}
        altSecundaria=""
        colorBlob="acento"
        posicionSecundaria="abajo-derecha"
      />
    </div>

    <div class="reveal space-y-5">
      <h2 class="balance font-display text-[28px] font-semibold leading-tight text-marca sm:text-[36px]">
        {meli.titulo}
      </h2>
      <div>
        <p class="text-[15px] font-bold uppercase tracking-wide text-marca">{meli.nombre}</p>
        <p class="text-sm text-texto/55">{meli.rol}</p>
      </div>
      <div class="space-y-3 text-[15px] leading-relaxed text-texto/70 sm:text-[16px]">
        {meli.parrafos.map((p) => <p>{p}</p>)}
      </div>
      <p class="subrayado subrayado-marca balance pt-2 font-display text-[19px] font-semibold uppercase leading-snug tracking-tight text-marca sm:text-[23px]">
        {meli.frase}
      </p>
    </div>
  </div>
</section>
