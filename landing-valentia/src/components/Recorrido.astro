---
import { recorrido } from "../content/valentia";
import { REGISTER_URL } from "../config/site";
---

<section id="como-funciona" class="bg-tarjeta px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-5xl">
    <h2 class="reveal balance mx-auto max-w-lg text-center font-display text-[28px] font-semibold leading-tight text-texto sm:text-[38px]">
      {recorrido.titulo.map((linea) => <span class="block">{linea}</span>)}
    </h2>

    <div class="mt-14 grid gap-4 sm:mt-16 sm:grid-cols-2 lg:grid-cols-5 lg:gap-5">
      {recorrido.pasos.map((paso) => (
        <div class="reveal space-y-3 rounded-[20px] border border-texto/10 bg-fondo p-6">
          <p class="font-display text-3xl font-semibold text-acento">{paso.numero}</p>
          <p class="text-[16px] font-semibold text-texto">{paso.titulo}</p>
          <p class="text-sm leading-relaxed text-texto/60">{paso.texto}</p>
        </div>
      ))}
    </div>

    <div class="reveal mt-12 text-center">
      <a
        href={REGISTER_URL}
        data-analytics="click-empezar-recorrido"
        class="inline-block rounded-full bg-texto px-8 py-4 text-[15px] font-semibold text-fondo transition hover:bg-acento hover:text-texto"
      >
        {recorrido.cta}
      </a>
    </div>
  </div>
</section>
