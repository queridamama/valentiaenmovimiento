---
import { faq } from "../content/valentia";
---

<section class="bg-tarjeta px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-2xl">
    <h2 class="reveal text-center font-display text-[28px] font-semibold text-marca sm:text-[34px]">{faq.titulo}</h2>

    <div class="reveal mt-10 divide-y divide-texto/10 sm:mt-12">
      {faq.items.map((item) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-medium text-marca [&::-webkit-details-marker]:hidden">
            {item.pregunta}
            <span class="shrink-0 text-xl text-texto/40 transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-[15px] leading-relaxed text-texto/65">{item.respuesta}</p>
        </details>
      ))}
    </div>
  </div>
</section>
