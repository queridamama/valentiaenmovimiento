---
import { hero } from "../content/valentia";
import { REGISTER_URL, LOGIN_URL, withBase } from "../config/site";
import FotoMarca from "./FotoMarca.astro";
import Doodle from "./Doodle.astro";
---

<section id="hero" class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-10 sm:px-8 sm:pb-20 sm:pt-16 lg:grid-cols-2 lg:gap-16 lg:pb-28 lg:pt-20">
    <div class="reveal order-2 space-y-6 lg:order-1">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-marca">{hero.eyebrow}</p>

      <h1 class="balance relative font-display text-[38px] font-semibold leading-[1.08] text-marca sm:text-[48px] lg:text-[54px]">
        TOMATE TUS SUEÑOS
        <span class="relative inline-block">
          <span class="marcador marcador-lima">EN SERIO.</span>
          <Doodle
            tipo="flecha-izq"
            color="var(--color-acento)"
            class="pointer-events-none absolute -left-14 top-1/2 hidden h-6 w-12 -translate-y-1/2 sm:block"
          />
        </span>
      </h1>

      <div class="max-w-md space-y-3 text-[16px] leading-relaxed text-texto/70 sm:text-[17px]">
        {hero.copy.map((p) => <p>{p}</p>)}
      </div>

      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center">
        <a
          href={REGISTER_URL}
          data-analytics="click-empezar-gratis-hero"
          class="rounded-full bg-marca px-7 py-4 text-center text-[15px] font-semibold text-fondo transition hover:bg-acento hover:text-marca"
        >
          {hero.ctaPrincipal}
        </a>
        <a href={LOGIN_URL} data-analytics="click-entrar-hero" class="text-center text-[15px] font-semibold text-marca/75 hover:text-marca">
          {hero.ctaSecundario}
        </a>
      </div>
      <p class="text-xs font-medium uppercase tracking-wide text-texto/40">{hero.microfrase}</p>
    </div>

    <div class="reveal order-1 lg:order-2">
      <FotoMarca
        src={withBase("images/valentia/hero.jpg")}
        alt="Mujer en movimiento hacia su sueño — imagen editorial de Valentía en Movimiento"
        srcSecundaria={withBase("images/valentia/hero-detalle.jpg")}
        altSecundaria=""
        colorBlob="celeste"
        posicionSecundaria="abajo-izquierda"
        class="mx-auto w-full max-w-[300px] sm:max-w-[360px] lg:max-w-[400px]"
      />
    </div>
  </div>
</section>
