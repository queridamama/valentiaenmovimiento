---
import { hero } from "../content/valentia";
import { REGISTER_URL, LOGIN_URL, withBase } from "../config/site";
---

<section id="hero" class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 pb-14 pt-10 sm:px-8 sm:pb-20 sm:pt-16 lg:grid-cols-2 lg:gap-16 lg:pb-28 lg:pt-20">
    <div class="reveal order-2 space-y-6 lg:order-1">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-acento-teal">{hero.eyebrow}</p>
      <h1 class="balance font-display text-[38px] font-semibold leading-[1.05] text-texto sm:text-[48px] lg:text-[58px]">
        {hero.headline}
      </h1>
      <div class="max-w-md space-y-3 text-[16px] leading-relaxed text-texto/70 sm:text-[17px]">
        {hero.copy.map((p) => <p>{p}</p>)}
      </div>

      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center">
        <a
          href={REGISTER_URL}
          data-analytics="click-empezar-gratis-hero"
          class="rounded-full bg-texto px-7 py-4 text-center text-[15px] font-semibold text-fondo transition hover:bg-acento hover:text-texto"
        >
          {hero.ctaPrincipal}
        </a>
        <a href={LOGIN_URL} data-analytics="click-entrar-hero" class="text-center text-[15px] font-semibold text-texto/70 hover:text-texto">
          {hero.ctaSecundario}
        </a>
      </div>
      <p class="text-xs font-medium uppercase tracking-wide text-texto/40">{hero.microfrase}</p>
    </div>

    <div class="reveal order-1 lg:order-2">
      <div class="relative mx-auto aspect-[4/5] w-full max-w-sm overflow-hidden rounded-[28px] sm:max-w-md lg:max-w-none">
        <img
          src={withBase("images/valentia/hero.jpg")}
          alt="Mujer en movimiento hacia su sueño — imagen editorial de Valentía en Movimiento"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
