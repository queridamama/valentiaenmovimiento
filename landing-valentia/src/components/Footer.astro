---
import { nav, marca } from "../content/valentia";
import { REGISTER_URL, LOGIN_URL } from "../config/site";
import Logo from "./Logo.astro";

const anio = new Date().getFullYear();
---

<footer class="border-t border-marca/10 bg-fondo px-5 py-12 sm:px-8">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
    <div class="space-y-3">
      <Logo tamano="chico" />
      <p class="max-w-xs text-sm text-texto/55">{marca.tagline}</p>
    </div>

    <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-marca/70">
      {nav.links.map((link) => (
        <a href={link.href} class="hover:text-marca">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex gap-3">
      <a href={LOGIN_URL} class="rounded-full border border-marca/25 px-4 py-2 text-sm font-medium text-marca">
        {nav.entrar}
      </a>
      <a href={REGISTER_URL} class="rounded-full bg-marca px-4 py-2 text-sm font-semibold text-fondo">
        {nav.cta}
      </a>
    </div>
  </div>

  <p class="mx-auto mt-10 max-w-6xl text-xs text-texto/40">
    © {anio} {marca.nombre}. Un proyecto de Melisa Díaz.
  </p>
</footer>
