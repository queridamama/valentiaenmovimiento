---
import { appShowcase } from "../content/valentia";
import { withBase } from "../config/site";

// Leve desfase vertical alternado para que la fila de pantallas se sienta
// compuesta a mano y no como una grilla de producto genérica.
const desfases = ["sm:translate-y-0", "sm:translate-y-6", "sm:-translate-y-3", "sm:translate-y-4", "sm:translate-y-0"];
---

<section class="px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mx-auto max-w-lg space-y-3 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-marca">{appShowcase.eyebrow}</p>
      <h2 class="balance font-display text-[28px] font-semibold leading-tight text-marca sm:text-[38px]">
        {appShowcase.titulo}
      </h2>
      <p class="text-[16px] text-texto/60">{appShowcase.texto}</p>
      <p class="text-[14px] text-texto/45">{appShowcase.textoComunidad}</p>
    </div>

    <div class="reveal mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 sm:mt-16 sm:justify-center sm:gap-6 sm:px-0">
      {appShowcase.pantallas.map((pantalla, i) => (
        <div class={`shrink-0 snap-center transition ${desfases[i % desfases.length]}`}>
          <div class="w-[220px] rounded-[26px] border-4 border-marca bg-white p-2 shadow-[0_18px_40px_-15px_rgba(26,26,26,0.35)] sm:w-[240px]">
            <div class="overflow-hidden rounded-[18px] bg-tarjeta">
              <img
                src={withBase(`images/app/${pantalla.archivo}`)}
                alt={pantalla.alt}
                loading="lazy"
                class="aspect-[9/16] w-full object-contain"
              />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
