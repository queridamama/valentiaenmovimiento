---
// Pequeños acentos dibujados a mano (el lenguaje visual real de la marca:
// flechitas, puntitos, corazón, garabato) — un solo componente chico en
// vez de repetir SVG suelto en cada sección.
interface Props {
  tipo: "flecha-izq" | "flecha-der" | "puntos" | "corazon" | "garabato";
  color?: string;
  class?: string;
}

const { tipo, color = "currentColor", class: className = "" } = Astro.props;
---

{
  tipo === "flecha-izq" && (
    <svg viewBox="0 0 60 24" class={className} fill="none" aria-hidden="true">
      <path
        d="M58 12c-14 1-30 1.5-56 0"
        stroke={color}
        stroke-width="2.5"
        stroke-linecap="round"
      />
      <path d="M10 5c-4 2.5-7 5-8 7 1 2 4 4.5 8 7" stroke={color} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </svg>
  )
}
{
  tipo === "flecha-der" && (
    <svg viewBox="0 0 60 24" class={className} fill="none" aria-hidden="true">
      <path d="M2 12c14 1 30 1.5 56 0" stroke={color} stroke-width="2.5" stroke-linecap="round" />
      <path d="M50 5c4 2.5 7 5 8 7-1 2-4 4.5-8 7" stroke={color} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    </svg>
  )
}
{
  tipo === "puntos" && (
    <svg viewBox="0 0 60 16" class={className} aria-hidden="true">
      <circle cx="4" cy="8" r="3" fill={color} />
      <circle cx="20" cy="4" r="2.3" fill={color} />
      <circle cx="34" cy="11" r="2.6" fill={color} />
      <circle cx="50" cy="6" r="2" fill={color} />
    </svg>
  )
}
{
  tipo === "corazon" && (
    <svg viewBox="0 0 32 28" class={className} aria-hidden="true">
      <path
        d="M16 25C6 18 2 13 2 8.5 2 4.5 5 2 8.5 2c2.6 0 4.8 1.6 5.9 3.9C15.7 3.6 17.9 2 20.5 2 24 2 27 4.5 27 8.5c0 4.5-4 9.5-14 16.5-.6-.4.6.4 0 0Z"
        fill={color}
      />
    </svg>
  )
}
{
  tipo === "garabato" && (
    <svg viewBox="0 0 220 24" preserveAspectRatio="none" class={className} fill="none" aria-hidden="true">
      <path
        d="M2 14c14-13 24 10 38 2 12-7 20 9 34 3 13-6 22 9 36 2 13-6 22 9 36 2 13-6 22 9 36 2 5-2 8-3 10-5"
        stroke={color}
        stroke-width="5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}
