---
import { premium } from "../content/valentia";
import { REGISTER_URL } from "../config/site";
import Doodle from "./Doodle.astro";

const coloresEtapa = ["acento", "lima", "celeste", "rosa", "acento"] as const;
const bgEtapa: Record<(typeof coloresEtapa)[number], string> = {
  acento: "bg-acento/20 text-acento-teal",
  lima: "bg-acento-lima/30 text-texto",
  celeste: "bg-acento-celeste/40 text-acento-teal",
  rosa: "bg-acento-rosa text-texto",
};
---

<section id="premium" class="px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-4xl">
    <div class="reveal space-y-4 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-acento-teal">{premium.eyebrow}</p>
      <h2 class="balance mx-auto max-w-2xl font-display text-[28px] font-semibold leading-tight text-texto sm:text-[38px]">
        {premium.titulo}
      </h2>
      <p class="subrayado subrayado-acento inline-block text-[18px] font-medium text-texto/80">{premium.subtitulo}</p>
      <p class="mx-auto max-w-lg text-[16px] text-texto/60">{premium.texto}</p>
    </div>

    <div class="reveal mt-12 flex flex-wrap items-center justify-center gap-2.5 sm:mt-14 sm:gap-3">
      {premium.etapas.map((etapa, i) => {
        const color = coloresEtapa[i % coloresEtapa.length];
        return (
          <>
            <span
              class={`inline-block rounded-full px-4 py-2.5 text-sm font-bold tracking-wide sm:px-5 sm:text-base ${bgEtapa[color]}`}
              style={`transform: rotate(${i % 2 === 0 ? "-2deg" : "2deg"});`}
            >
              {etapa}
            </span>
            {i < premium.etapas.length - 1 && <span class="text-texto/25">→</span>}
          </>
        );
      })}
    </div>

    <p class="reveal mt-10 text-center font-display text-xl font-semibold leading-snug text-texto sm:text-2xl">
      {premium.frase.map((linea) => <span class="block">{linea}</span>)}
    </p>

    <div class="reveal mt-14 grid gap-4 sm:mt-16 sm:grid-cols-2">
      <div class="space-y-3 rounded-[20px] bg-texto/5 p-6 sm:p-7">
        <p class="text-xs font-semibold uppercase tracking-wide text-texto/45">Esto no es</p>
        <ul class="space-y-2">
          {premium.noEs.map((n) => (
            <li class="text-[15px] text-texto/55">{n}</li>
          ))}
        </ul>
      </div>
      <div class="space-y-3 rounded-[20px] bg-acento-lima/15 p-6 sm:p-7">
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold uppercase tracking-wide text-acento-teal">Esto sí es</p>
          <Doodle tipo="corazon" color="var(--color-acento)" class="h-3.5 w-3.5" />
        </div>
        <ul class="flex flex-wrap gap-2">
          {premium.siEs.map((s, i) => (
            <li
              class="rounded-full bg-tarjeta px-3.5 py-1.5 text-[14px] font-medium text-texto"
              style={`transform: rotate(${i % 2 === 0 ? "-1deg" : "1deg"});`}
            >
              {s}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="reveal mt-10 grid gap-4 sm:grid-cols-2">
      <div class="space-y-1.5 rounded-[20px] border border-texto/10 bg-tarjeta p-6 text-center">
        <p class="text-xs font-semibold uppercase tracking-wide text-texto/45">{premium.comparacion.gratis.titulo}</p>
        <p class="text-[16px] font-medium text-texto">{premium.comparacion.gratis.texto}</p>
      </div>
      <div class="space-y-1.5 rounded-[20px] border border-acento/40 bg-acento/10 p-6 text-center">
        <p class="text-xs font-semibold uppercase tracking-wide text-acento-teal">{premium.comparacion.premium.titulo}</p>
        <p class="text-[16px] font-medium text-texto">{premium.comparacion.premium.texto}</p>
      </div>
    </div>

    <div class="reveal mt-12 text-center">
      <a
        href={REGISTER_URL}
        data-analytics="click-conocer-premium"
        class="inline-block rounded-full border border-texto/20 px-7 py-3.5 text-[15px] font-semibold text-texto transition hover:border-texto"
      >
        {premium.cta}
      </a>
      <p class="mt-3 text-xs text-texto/45">Empezás gratis — Premium se activa cuando quieras dar el salto.</p>
    </div>
  </div>
</section>
