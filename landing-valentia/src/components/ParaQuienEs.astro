---
import { paraQuienEs } from "../content/valentia";
---

<section class="px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-3xl">
    <h2 class="reveal balance text-center font-display text-[28px] font-semibold leading-tight text-marca sm:text-[38px]">
      {paraQuienEs.titulo}
    </h2>
    <ul class="mt-12 space-y-4 sm:mt-14">
      {paraQuienEs.items.map((item) => (
        <li class="reveal flex items-start gap-3 rounded-[18px] border border-texto/10 bg-tarjeta p-5 text-[16px] leading-relaxed text-texto/75">
          <span class="mt-1 text-acento">✓</span>
          {item}
        </li>
      ))}
    </ul>
  </div>
</section>
