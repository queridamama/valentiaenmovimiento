---
import { tesis } from "../content/valentia";
import Doodle from "./Doodle.astro";

const [linea1, linea2] = tesis.titulo;
---

<section id="que-es" class="px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-4xl space-y-12 text-center">
    <h2 class="reveal balance font-display text-[30px] font-semibold leading-[1.15] text-marca sm:text-[44px] lg:text-[50px]">
      <span class="block">{linea1}</span>
      <span class="mt-2 block font-marcador text-[34px] font-normal leading-none text-marca sm:text-[46px] lg:text-[52px]">
        <span class="marcador marcador-lima">{linea2}</span>
      </span>
    </h2>

    <div class="reveal mx-auto max-w-xl space-y-3">
      <p class="text-[17px] leading-relaxed text-texto/70">{tesis.texto}</p>
      <p class="text-[16px] font-semibold text-marca">{tesis.cierre}</p>
    </div>

    <div class="reveal flex flex-wrap items-center justify-center gap-3 pt-4 sm:gap-4">
      {tesis.formula.map((palabra, i) => (
        <>
          <span
            class="inline-block rounded-full border-2 border-marca bg-tarjeta px-5 py-2.5 text-sm font-semibold tracking-wide text-marca sm:px-6 sm:py-3 sm:text-base"
            style={`transform: rotate(${i % 2 === 0 ? "-1.5deg" : "1.5deg"});`}
          >
            {palabra}
          </span>
          {i < tesis.formula.length - 1 && <span class="text-lg text-marca/30">+</span>}
        </>
      ))}
    </div>

    <div class="reveal flex justify-center pt-2">
      <Doodle tipo="puntos" color="var(--color-acento)" class="h-4 w-16" />
    </div>
  </div>
</section>
